{
  "name": "friendship-helper",
  "version": "1.0.0",
  "description": "Tell Claude what your friend said (or a screenshot) and get replies in 100 styles, with fully customizable themes.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:direct": "esbuild src/direct.js --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=public/vendor/claude-direct.js",
    "android:sync": "npm run build:direct && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoborkowski-boop/Friendship-helper.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leoborkowski-boop/Friendship-helper/issues"
  },
  "homepage": "https://github.com/leoborkowski-boop/Friendship-helper#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.28.2"
  }
}
